{
  "extends": "next/core-web-vitals",
  "rules": {
    // 1) Detectar código sin usar (variables y decoradores)
    "no-unused-vars": "off", // Desactivamos la base para usar la de TS si usas TypeScript
    "@typescript-eslint/no-unused-vars": ["warn"], 
    
    // 2) Detectar console.logs y arrojar error
    "no-console": ["error", { "allow": ["warn", "error"] }]
  }
}